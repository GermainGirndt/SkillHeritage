{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "assets/**/*",
        "outDir": "dist"
      },
  
      {
        "include": "**/*.py",
        "outDir": "dist"
      }
    
    ]
  }
}
